# aaf-ai231-me3 — environment template
# Copy to a location OUTSIDE this repo, chmod 600, then source it or point the
# service at it. Never commit real values.

# Ollama Cloud (LLM)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b

# Jetson speech services (Ethernet)
ASR_SERVER=192.168.5.11:50051
ASR_BACKEND=nemotron
# Optional VAD-segmented DGX audio-language model for transcription.
DGX_ASR_BASE=http://127.0.0.1:18000
DGX_ASR_MODEL=Qwen/Qwen2-Audio-7B-Instruct
DGX_ASR_TIMEOUT_SECS=15
# Optional Jetson Voxtral server with deploy/jetson/voxtral-chat.jinja.
VOXTRAL_BASE=http://192.168.5.11:8083
VOXTRAL_MODEL=mistralai/Voxtral-Mini-3B-2507
VOXTRAL_ASR_TIMEOUT_SECS=15
TTS_SERVER=192.168.5.11:50052
TTS_VOICE=0
# Select TTS independently of ASR; dgx_qwen enables DGX streaming TTS.
TTS_BACKEND=magpie
DGX_TTS_BASE=http://127.0.0.1:18001
DGX_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
DGX_TTS_VOICE=vivian
DGX_TTS_TIMEOUT_SECS=45
# Optional MacBook MLX Qwen3 TTS via SSH-forwarded Pi port 18099.
# Select TTS_BACKEND=mac_qwen only for the later trial.
MAC_TTS_BASE=http://127.0.0.1:18099
MAC_TTS_VOICE=Aiden
MAC_TTS_TIMEOUT_SECS=45
# DGX_API_KEY belongs only in the private environment outside Git.

# Pi-local VAD policy (seconds of silence that ends the turn)
VAD_STOP_SECS=0.7

# VCM MCP placement: Pi is the project default; Jetson is an explicit trial.
VCM_TOOL_SERVER_HOST=pi
# Pi MCP executes tool logic locally; SQLite lives in a Jetson worker by default.
# Set local_sqlite explicitly only for a Pi-local persistence comparison.
VCM_STATE_BACKEND=jetson_sqlite
VCM_STATE_TIMEOUT_SECS=8
VCM_JETSON_SSH_TARGET=aldwin@192.168.5.11
VCM_JETSON_SSH_KEY=/home/aldwinrpi4/.ssh/id_ed25519_vcm_jetson
VCM_JETSON_KNOWN_HOSTS=/home/aldwinrpi4/.ssh/known_hosts_vcm_jetson
VCM_JETSON_DATA_DIR=/home/aldwin/voice-agent-vcm/state

# local_vcm: llama|laya. two_brain_plusjev: jev|laya (explicit GLM fallback).
# For the contextual comparison use two_brain_plusjev and ROUTER_MODEL=laya.
# Laya requires the separate ThinkPad classifier service and Pi tunnel.
ROUTER_MODEL=llama
LAYA_ROUTER_URL=http://127.0.0.1:18082
LAYA_ROUTER_TIMEOUT_SECS=2
# clarify or llama_reply (conversation only, never model tool extraction/cloud).
LAYA_FALLBACK_POLICY=clarify
