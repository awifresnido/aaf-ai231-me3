# aaf-ai231-me3 — environment template
# Copy to a location OUTSIDE this repo, chmod 600, then source it or point the
# service at it. Never commit real values.

# Ollama Cloud (LLM)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b

# Jetson speech services (Ethernet)
ASR_SERVER=192.168.5.11:50051
TTS_SERVER=192.168.5.11:50052
TTS_VOICE=0

# Pi-local VAD policy (seconds of silence that ends the turn)
VAD_STOP_SECS=0.7
