# aaf-ai231-me3 — environment template
# Copy to a location OUTSIDE this repo, chmod 600, then source it or point the
# service at it. Never commit real values.
#
# Branch llama32-vps: LLM = Llama 3.2 3B Instruct (Q4_K_M GGUF) served by
# llama-server on the VPS (OpenAI-compatible API, port 8010).

# LLM — llama.cpp server on the VPS (no real key needed; any non-empty value)
LLM_BASE_URL=http://72.62.76.173:8010/v1
LLM_MODEL=llama3.2-3b
LLM_API_KEY=none
# (legacy names still honoured as fallbacks)
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=

# Jetson speech services (Ethernet)
ASR_SERVER=192.168.5.11:50051
TTS_SERVER=192.168.5.11:50052
TTS_VOICE=0

# Pi-local VAD policy (seconds of silence that ends the turn)
VAD_STOP_SECS=0.7
