[Unit]
Description=Pi loopback access to optional ThinkPad Laya router
Requires=voice-agent-laya.service
After=voice-agent-laya.service network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -F /dev/null -i /home/aldlinux/.ssh/id_ed25519_pihost -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/home/aldlinux/.ssh/known_hosts_pihost -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -N -R 127.0.0.1:18082:127.0.0.1:8082 aldwinrpi4@192.168.5.12
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
