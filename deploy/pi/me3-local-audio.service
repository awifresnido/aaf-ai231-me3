[Unit]
Description=ME3 voice agent - Pi-local audio (JOUNIVO USB speakerphone)
Documentation=https://github.com/awifresnido/aaf-ai231-me3
After=sound.target
Conflicts=voice-agent-two-brain-webrtc.service
# The transport opens the PulseAudio bridge device, so the daemon must be up.

[Service]
Type=simple
WorkingDirectory=/home/aldwinrpi4/voice-agent
Environment=TRANSPORT_MODE=local
Environment=PYTHONUNBUFFERED=1
# The JV801P keeps its level in a USB ALSA control, and alsa-restore does not
# persist our change (/var/lib/alsa/asound.state predates it). At 0% the device
# is silent while everything else looks healthy, so force it on every start.
ExecStartPre=/usr/bin/amixer -c JV801P sset PCM 100% unmute
# Let the USB speakerphone enumerate as ALSA card 1 before we open it.
ExecStartPre=/bin/sleep 3
ExecStart=/home/aldwinrpi4/pipecat-quickstart/server/.venv/bin/python bot.py
# This Pi has no persistent user journal, so log to a file instead.
StandardOutput=append:/home/aldwinrpi4/voice-agent/me3-local-audio.log
StandardError=append:/home/aldwinrpi4/voice-agent/me3-local-audio.log
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0077

[Install]
WantedBy=default.target
