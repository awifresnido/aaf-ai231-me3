[Unit]
Description=ME3 dashboard on the Pi (access through SSH)
After=network.target

[Service]
WorkingDirectory=%h/voice-agent/dashboard-bundle/dashboard
Environment=DASHBOARD_DATA_DIR=/dev/shm/voice-agent-diagnostics
Environment=DASHBOARD_SAVED_DIR=%h/voice-agent/dashboard-data/saved
Environment=DASHBOARD_LOCAL_CONTROL=1
ExecStart=%h/pipecat-quickstart/server/.venv/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 9010
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
